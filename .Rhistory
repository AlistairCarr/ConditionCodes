condition_list = test,
mm_outcome_name = "cardiometabolic",
condition_threshold = 3,
coding_systems = "all",
patient_ID = "eid",
by_phenotype = TRUE,
contributing_conditions = TRUE, condition_diagnoses = TRUE, condition_count = TRUE)
